# Files and folders excluded from the distributed plugin ZIP.
# rsync --exclude-from patterns (leading / anchors to the plugin root).
/.git
/.github
/.gitignore
/.gitattributes
/.distignore
/tools
/node_modules
/.vscode
/.idea
_*.json
*.zip
*.log
# Gettext sources — only the compiled .mo is needed at runtime; .po stays in git.
/lang/*.po
.DS_Store
Thumbs.db
