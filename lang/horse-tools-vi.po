msgid "Author and maintainer:"
msgstr "Tác giả và người duy trì:"

msgid "Licence:"
msgstr "Giấy phép:"

msgid "Original contributors:"
msgstr "Người đóng góp cho bản gốc:"

msgid "Foxtool by Fox Theme (Nguyễn Ngọc Hoàn)"
msgstr "Foxtool của Fox Theme (Nguyễn Ngọc Hoàn)"

msgid "Horse Tools is built on %s, which is no longer maintained by its author. That original work is gratefully acknowledged and this fork continues under the same GPLv2 licence."
msgstr "Horse Tools được phát triển dựa trên %s, hiện tác giả không còn duy trì. Xin ghi nhận công sức của bản gốc; bản phát triển này tiếp tục theo cùng giấy phép GPLv2."

msgid "Duplicate content"
msgstr "Nhân bản nội dung"

msgid "Hide plugins from the manager"
msgstr "Ẩn plugin khỏi trang quản lý"

msgid "This feature will hide the plugin you want from the plugin management page"
msgstr "Tính năng này sẽ ẩn plugin bạn chọn khỏi trang quản lý plugin"

msgid "Reset this setting"
msgstr "Đặt lại tuỳ chọn này"

msgid "Forced ad clicks — removed"
msgstr "Ép click quảng cáo — đã gỡ bỏ"

msgid "This feature was removed in Horse Tools 1.0.0. It opened an affiliate URL in a hidden off-screen window every time a visitor clicked anywhere on the page. That is affiliate cookie stuffing: it deceives your visitors, breaks the terms of every major affiliate network and of Google AdSense, and can get your domain and your ad accounts banned."
msgstr "Tính năng này đã bị gỡ trong Horse Tools 1.0.0. Nó mở một liên kết affiliate trong cửa sổ ẩn ngoài màn hình mỗi khi khách click vào bất kỳ đâu trên trang. Đó là hành vi nhồi cookie affiliate: lừa dối người truy cập, vi phạm điều khoản của mọi mạng affiliate lớn và của Google AdSense, và có thể khiến tên miền cùng tài khoản quảng cáo của bạn bị khoá."

msgid "If you had it enabled it is now inactive. The AdSense and ads.txt tools on the other tabs are unaffected."
msgstr "Nếu trước đây bạn có bật, giờ nó đã ngừng hoạt động. Các công cụ AdSense và ads.txt ở những tab khác không bị ảnh hưởng."

msgid "I am sorry, you can only upload image files in the formats .GIF, .JPG, .PNG, .WEBP"
msgstr "Rất tiếc, bạn chỉ có thể tải lên ảnh ở các định dạng .GIF, .JPG, .PNG, .WEBP"

msgid "You do not have permission to upload SVG files."
msgstr "Bạn không có quyền tải lên tệp SVG."

msgid "SVG uploads are unavailable: the sanitiser library is missing."
msgstr "Không thể tải lên SVG: thiếu thư viện làm sạch tệp."

msgid "Unable to read the uploaded SVG file."
msgstr "Không đọc được tệp SVG vừa tải lên."

msgid "Unable to write the sanitised SVG file."
msgstr "Không ghi được tệp SVG sau khi làm sạch."

msgid "This SVG file could not be parsed and was rejected."
msgstr "Không phân tích được tệp SVG này nên đã từ chối."

msgid "That address cannot be fetched from this server."
msgstr "Máy chủ không được phép truy cập địa chỉ này."

msgid "Security check failed. Please start the sign-in again."
msgstr "Kiểm tra bảo mật thất bại. Vui lòng đăng nhập lại từ đầu."

msgid "Your Google account email address is not verified."
msgstr "Địa chỉ email của tài khoản Google chưa được xác minh."

msgid "Registration is disabled on this site."
msgstr "Trang web này đang tắt chức năng đăng ký."

msgid "You do not have permission to do this."
msgstr "Bạn không có quyền thực hiện thao tác này."

msgid "You are not allowed to duplicate this item."
msgstr "Bạn không được phép nhân bản mục này."

msgid "You are not allowed to create this post type."
msgstr "Bạn không được phép tạo loại nội dung này."

msgid "Feeds are not available on this site. %s"
msgstr "Trang web này không cung cấp nguồn cấp dữ liệu (feed). %s"

msgid "Feeds disabled"
msgstr "Đã tắt nguồn cấp dữ liệu"

msgid "Go to the home page"
msgstr "Về trang chủ"

msgid "None"
msgstr "Không dùng"

msgid "v3 score threshold (0 – 1)"
msgstr "Ngưỡng điểm v3 (0 – 1)"

msgid "The score threshold applies to reCAPTCHA v3 only. Google returns 1.0 for traffic it is confident is human and 0.0 for traffic it is confident is a bot; 0.5 is the recommended starting point. Raise it to block more aggressively, lower it if real visitors are being turned away."
msgstr "Ngưỡng điểm chỉ áp dụng cho reCAPTCHA v3. Google trả về 1.0 khi chắc chắn là người thật và 0.0 khi chắc chắn là bot; nên bắt đầu từ 0.5. Tăng lên để chặn gắt hơn, giảm xuống nếu khách thật bị chặn nhầm."

msgid "If the Secret key is empty the check is skipped entirely rather than rejecting every login."
msgstr "Nếu để trống Secret key thì bước kiểm tra sẽ được bỏ qua hoàn toàn, thay vì từ chối mọi lượt đăng nhập."

msgid "Source code and issues:"
msgstr "Mã nguồn và báo lỗi:"

msgid "Search settings…"
msgstr "Tìm trong cài đặt…"

msgid "No setting matches that."
msgstr "Không có cài đặt nào khớp."

msgid "Currently enabled"
msgstr "Đang bật"

msgid "Nothing on this page is enabled yet."
msgstr "Trang này chưa bật cài đặt nào."

msgid "%d enabled"
msgstr "Đang bật %d"

msgid "You have unsaved changes."
msgstr "Bạn có thay đổi chưa lưu."

msgid "Save changes"
msgstr "Lưu thay đổi"

msgid "Discard"
msgstr "Bỏ thay đổi"

msgid "SCHEDULE"
msgstr "LỊCH"

msgid "Automatic cleanup"
msgstr "Dọn dẹp tự động"

msgid "Save schedule"
msgstr "Lưu lịch"

msgid "Off"
msgstr "Tắt"

msgid "Daily"
msgstr "Hằng ngày"

msgid "Weekly"
msgstr "Hằng tuần"

msgid "Monthly"
msgstr "Hằng tháng"

msgid "Cancel"
msgstr "Huỷ"

msgid "Confirm deletion"
msgstr "Xác nhận xoá"

msgid "Pending comments"
msgstr "Bình luận chờ duyệt"

msgid "Spam comments"
msgstr "Bình luận spam"

msgid "Trashed comments"
msgstr "Bình luận trong thùng rác"

msgid "Comments containing links"
msgstr "Bình luận chứa liên kết"

msgid "I understand this permanently deletes data."
msgstr "Tôi hiểu thao tác này xoá dữ liệu vĩnh viễn."

msgid "Nothing to delete."
msgstr "Không có gì để xoá."

msgid "Error — nothing was deleted."
msgstr "Lỗi — không xoá được gì."

msgid "up to %s"
msgstr "tối đa %s"

msgid "Deleted: %s"
msgstr "Đã xoá: %s"

msgid "Deleted %1$s of %2$s scanned"
msgstr "Đã xoá %1$s trong %2$s đã quét"

msgid "Next automatic check: %s"
msgstr "Lần kiểm tra tự động kế tiếp: %s"

msgid "Permanently delete %1$s from “%2$s”? This cannot be undone."
msgstr "Xoá vĩnh viễn %1$s từ “%2$s”? Không thể hoàn tác."

msgid "Run “%s” now? This permanently deletes matching items and cannot be undone."
msgstr "Chạy “%s” ngay bây giờ? Thao tác xoá vĩnh viễn các mục khớp và không thể hoàn tác."

msgid "Deleting is permanent. Revisions, autosaves and trashed content (posts, pages, products) are removed together with their metadata and attached files."
msgstr "Xoá là vĩnh viễn. Bản nháp, bản lưu tự động và nội dung trong thùng rác (bài viết, trang, sản phẩm) bị xoá cùng metadata và tệp đính kèm."

msgid "\"Comments containing links\" matches links in the comment body only. The figure shown is the total comment count, not a match count, so confirm carefully."
msgstr "“Bình luận chứa liên kết” chỉ khớp liên kết trong nội dung bình luận. Con số hiển thị là tổng số bình luận, không phải số khớp, nên hãy xác nhận cẩn thận."

msgid "Removes attachments whose file is missing from disk. Every attachment is scanned, so the count is known only after it runs."
msgstr "Xoá các tệp đính kèm có file đã mất khỏi ổ đĩa. Mọi tệp đính kèm đều được quét, nên chỉ biết số lượng sau khi chạy."

msgid "Removes metadata entries for thumbnail files that are missing from disk. It does not delete images."
msgstr "Xoá các mục metadata của ảnh thu nhỏ đã mất khỏi ổ đĩa. Nó không xoá ảnh."

msgid "Use with care: your theme may need several image sizes to display correctly."
msgstr "Dùng thận trọng: giao diện của bạn có thể cần nhiều kích thước ảnh để hiển thị đúng."

msgid "Cleanup runs on WordPress cron, which only fires when your site receives traffic. Weekly and monthly are measured from the last run."
msgstr "Việc dọn dẹp chạy bằng cron của WordPress, vốn chỉ kích hoạt khi website có lượt truy cập. Hằng tuần và hằng tháng được tính từ lần chạy gần nhất."

msgid "Deleting comments by link pattern is intentionally excluded from automatic cleanup — it stays a manual action."
msgstr "Việc xoá bình luận theo mẫu liên kết được cố ý loại khỏi dọn dẹp tự động — nó vẫn là thao tác thủ công."

msgid "BACKUP"
msgstr "SAO LƯU"

msgid "Backup"
msgstr "Sao lưu"

msgid "Added"
msgstr "Thêm"

msgid "Changed"
msgstr "Thay đổi"

msgid "Removed"
msgstr "Xoá"

msgid "Setting group"
msgstr "Nhóm cài đặt"

msgid "These groups will change"
msgstr "Các nhóm sẽ thay đổi"

msgid "Preview changes"
msgstr "Xem trước thay đổi"

msgid "Apply import"
msgstr "Áp dụng nhập"

msgid "Download .json"
msgstr "Tải .json"

msgid "Choose a file"
msgstr "Chọn tệp"

msgid "Undo the last import"
msgstr "Hoàn tác lần nhập gần nhất"

msgid "Restore previous configuration"
msgstr "Khôi phục cấu hình trước đó"

msgid "Paste an export here, or upload a .json file"
msgstr "Dán dữ liệu xuất vào đây, hoặc tải lên tệp .json"

msgid "That is not a valid Horse Tools export file."
msgstr "Đây không phải tệp xuất hợp lệ của Horse Tools."

msgid "The file contained no Horse Tools settings to import."
msgstr "Tệp không chứa cài đặt Horse Tools nào để nhập."

msgid "Imported %d setting group(s). You can undo this below."
msgstr "Đã nhập %d nhóm cài đặt. Bạn có thể hoàn tác bên dưới."

msgid "The previous configuration has been restored."
msgstr "Đã khôi phục cấu hình trước đó."

msgid "There is no backup to restore."
msgstr "Không có bản sao lưu để khôi phục."

msgid "This includes every setting group, whether or not its module is currently enabled. Uploaded font files are not included — they live on this site."
msgstr "Bao gồm mọi nhóm cài đặt, bất kể module đang bật hay tắt. Không bao gồm tệp phông chữ đã tải lên — chúng nằm trên site này."

msgid "Applying overwrites these groups with the imported values. A one-click backup is kept so you can undo it."
msgstr "Việc áp dụng sẽ ghi đè các nhóm này bằng giá trị đã nhập. Một bản sao lưu được giữ lại để bạn hoàn tác bằng một cú nhấp."

msgid "The configuration from before your most recent import is stored. Restoring reverts every group to that snapshot."
msgstr "Cấu hình trước lần nhập gần nhất được lưu lại. Khôi phục sẽ đưa mọi nhóm về đúng bản chụp đó."

msgid "404 log"
msgstr "Nhật ký 404"

msgid "Record 404 hits"
msgstr "Ghi lại lượt truy cập 404"

msgid "Requested URL"
msgstr "URL được yêu cầu"

msgid "Hits"
msgstr "Lượt"

msgid "Last seen"
msgstr "Lần cuối"

msgid "Actions"
msgstr "Hành động"

msgid "Redirect"
msgstr "Chuyển hướng"

msgid "Ignore"
msgstr "Bỏ qua"

msgid "No 404s recorded yet."
msgstr "Chưa ghi nhận lỗi 404 nào."

msgid "Clear the whole log"
msgstr "Xoá toàn bộ nhật ký"

msgid "Create a 301 redirect from this URL"
msgstr "Tạo chuyển hướng 301 từ URL này"

msgid "Hide this URL from the log"
msgstr "Ẩn URL này khỏi nhật ký"

msgid "Delete this log entry"
msgstr "Xoá mục nhật ký này"

msgid "Log the dead URLs anonymous visitors actually hit, so you can turn the busy ones into redirects. Logged-in users, bots and asset requests are not recorded, and nothing leaves your site."
msgstr "Ghi lại các URL hỏng mà khách vãng lai thực sự truy cập, để bạn biến những URL nhiều lượt thành chuyển hướng. Không ghi người dùng đã đăng nhập, bot và các yêu cầu tài nguyên tĩnh, và không có gì rời khỏi site của bạn."

msgid "Limit login attempts"
msgstr "Giới hạn số lần đăng nhập"

msgid "Lock out repeated failed logins"
msgstr "Khoá khi đăng nhập sai nhiều lần"

msgid "After too many failed logins from the same address, block further attempts for a while. This is the real defence against password guessing."
msgstr "Sau quá nhiều lần đăng nhập sai từ cùng một địa chỉ, chặn tạm các lần thử tiếp theo. Đây là biện pháp thật sự chống dò mật khẩu."

msgid "Attempts before lockout"
msgstr "Số lần sai trước khi khoá"

msgid "Lockout length (minutes)"
msgstr "Thời gian khoá (phút)"

msgid "Email me when an address is locked out"
msgstr "Gửi email cho tôi khi một địa chỉ bị khoá"

msgid "A login was locked out on your site"
msgstr "Có một địa chỉ đăng nhập bị khoá trên site của bạn"

msgid "The address %1$s was locked out after repeated failed logins on %2$s."
msgstr "Địa chỉ %1$s đã bị khoá sau nhiều lần đăng nhập sai trên %2$s."

msgid "Too many failed attempts. Try again in about %d minute(s)."
msgstr "Quá nhiều lần thử sai. Vui lòng thử lại sau khoảng %d phút."

msgid "Login failed. Check your details and try again."
msgstr "Đăng nhập thất bại. Kiểm tra lại thông tin và thử lại."

msgid "Block user enumeration"
msgstr "Chặn dò tên người dùng"

msgid "Hide usernames from scanners"
msgstr "Ẩn tên người dùng khỏi công cụ quét"

msgid "Blocks ?author=N scans, removes the users REST endpoint for anonymous requests, strips the author from oEmbed, and makes login errors generic so they do not reveal whether the username or the password was wrong."
msgstr "Chặn quét ?author=N, gỡ endpoint users REST với khách vãng lai, bỏ tác giả khỏi oEmbed, và làm lỗi đăng nhập chung chung để không lộ sai tên hay sai mật khẩu."

msgid "Security response headers"
msgstr "HTTP header bảo mật"

msgid "Send security headers"
msgstr "Gửi các header bảo mật"

msgid "Add hardening headers to front-end responses. Each one below is optional."
msgstr "Thêm các header tăng cường bảo mật cho phản hồi front-end. Mỗi mục dưới đây là tuỳ chọn."

msgid "X-Frame-Options: SAMEORIGIN (block clickjacking)"
msgstr "X-Frame-Options: SAMEORIGIN (chặn clickjacking)"

msgid "X-Content-Type-Options: nosniff"
msgstr "X-Content-Type-Options: nosniff"

msgid "Referrer-Policy: strict-origin-when-cross-origin"
msgstr "Referrer-Policy: strict-origin-when-cross-origin"

msgid "Permissions-Policy: block geolocation, mic and camera"
msgstr "Permissions-Policy: chặn định vị, mic và camera"

msgid "HSTS (force HTTPS for 180 days)"
msgstr "HSTS (ép HTTPS trong 180 ngày)"

msgid "Only enable once HTTPS works everywhere. Browsers will refuse plain HTTP to your site for six months, and it cannot be undone quickly."
msgstr "Chỉ bật khi HTTPS đã chạy ở mọi nơi. Trình duyệt sẽ từ chối HTTP thường trong sáu tháng, và không thể huỷ nhanh."

msgid "Content-Security-Policy (advanced, leave blank if unsure)"
msgstr "Content-Security-Policy (nâng cao, để trống nếu không chắc)"

msgid "A wrong CSP silently breaks scripts, styles and images. Test with browser dev tools before relying on it."
msgstr "CSP sai sẽ âm thầm làm hỏng script, style và ảnh. Hãy kiểm tra bằng dev tools của trình duyệt trước khi dựa vào nó."

msgid "Lock down the admin"
msgstr "Khoá chặt khu quản trị"

msgid "Disable the theme & plugin file editor"
msgstr "Tắt trình sửa file theme & plugin"

msgid "Removes the built-in code editor under Appearance and Plugins. If an attacker gets into wp-admin, they cannot use it to edit PHP files. You edit files over SFTP instead."
msgstr "Gỡ trình sửa code trong Appearance và Plugins. Nếu kẻ tấn công vào được wp-admin, chúng không thể dùng nó để sửa file PHP. Bạn sửa file qua SFTP."

msgid "Disable unused endpoints"
msgstr "Tắt các endpoint không dùng"

msgid "Disable REST API for anonymous visitors"
msgstr "Tắt REST API cho khách vãng lai"

msgid "This blocks the REST API for logged-out visitors. It WILL break: WooCommerce cart and checkout for guests, Contact Form 7 and other REST-based forms, comment submission on block themes, and oEmbed. Only enable it if your site uses none of these."
msgstr "Chặn REST API cho khách chưa đăng nhập. Nó SẼ làm hỏng: giỏ hàng và thanh toán WooCommerce cho khách, Contact Form 7 và các form dùng REST, gửi bình luận trên block theme, và oEmbed. Chỉ bật nếu site của bạn không dùng những thứ này."

msgid "Recommended. xmlrpc.php is a common brute-force and pingback-amplification target and almost nothing uses it now (except Jetpack)."
msgstr "Khuyến nghị. xmlrpc.php là đích brute-force và khuếch đại pingback phổ biến, hầu như không còn gì dùng nó (trừ Jetpack)."

msgid "Removes wp-embed.js if you do not embed other WordPress posts."
msgstr "Gỡ wp-embed.js nếu bạn không nhúng bài viết WordPress khác."

msgid "Removes the X-Pingback header. Pairs with disabling XML-RPC."
msgstr "Gỡ header X-Pingback. Đi kèm với việc tắt XML-RPC."

msgid "Disable feeds (RSS/Atom)"
msgstr "Tắt feed (RSS/Atom)"

msgid "Turns off the RSS and Atom feeds if your site does not publish one."
msgstr "Tắt feed RSS và Atom nếu site của bạn không xuất bản feed."

msgid "Tidy up"
msgstr "Dọn dẹp"

msgid "Remove unnecessary header tags"
msgstr "Gỡ các thẻ header thừa"

msgid "Removes the RSD, WLW manifest and adjacent-post link tags from the page head."
msgstr "Gỡ các thẻ RSD, WLW manifest và link bài kề khỏi phần head."

msgid "Remove the WordPress version tag"
msgstr "Gỡ thẻ phiên bản WordPress"

msgid "Removes the generator meta tag. A small tidy-up — not a security measure on its own, since asset fingerprints reveal the version anyway."
msgstr "Gỡ thẻ meta generator. Chỉ là dọn dẹp nhỏ — không phải biện pháp bảo mật tự thân, vì dấu vết tài nguyên vẫn lộ phiên bản."

msgid "Automatic updates"
msgstr "Cập nhật tự động"

msgid "Do not auto-install core updates"
msgstr "Không tự cài cập nhật lõi"

msgid "Do not auto-install language pack updates"
msgstr "Không tự cài cập nhật gói ngôn ngữ"

msgid "Do not auto-install theme updates"
msgstr "Không tự cài cập nhật theme"

msgid "Do not auto-install plugin updates"
msgstr "Không tự cài cập nhật plugin"

msgid "Hide the update & maintenance notice"
msgstr "Ẩn thông báo cập nhật & bảo trì"

msgid "These stop WordPress installing updates on its own — the site still checks for them, so the Dashboard and Plugins screens keep showing what is available and you apply updates when you choose. It never stops checking, so you are never left unaware of a security release."
msgstr "Những mục này ngăn WordPress tự cài cập nhật — site vẫn kiểm tra, nên trang Dashboard và Plugins vẫn hiện các bản có sẵn và bạn tự áp dụng khi muốn. Nó không bao giờ ngừng kiểm tra, nên bạn không bao giờ bị bỏ lỡ một bản vá bảo mật."

msgid "Add an attribution line when visitors copy text"
msgstr "Thêm dòng ghi nguồn khi khách copy nội dung"

msgid "When someone copies text from your site, a short line you set is added after it — their selection is kept, nothing is replaced. Useful for a \"Source: yoursite.com\" credit."
msgstr "Khi ai đó copy nội dung từ site của bạn, một dòng ngắn bạn đặt được thêm vào sau — phần chọn của họ vẫn giữ nguyên, không thay thế gì. Hữu ích cho dòng \"Nguồn: site.com\"."

msgid "Attribution line"
msgstr "Dòng ghi nguồn"

msgid "Automatic redirects"
msgstr "Chuyển hướng tự động"

