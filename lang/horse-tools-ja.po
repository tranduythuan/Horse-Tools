msgid "WooCommerce / Store"
msgstr "WooCommerce / ストア"

msgid "WordPress runs shortcodes in post content by default. Turn these on to run them elsewhere too. (Saved with the SAVE button at the bottom.)"
msgstr "WordPress はデフォルトで投稿コンテンツ内のショートコードを実行します。これらをオンにすると、他の場所でも実行できます。（下部の保存ボタンで保存されます。）"

msgid "X-Content-Type-Options: nosniff"
msgstr "X-Content-Type-Options：nosniff"

msgid "X-Frame-Options: SAMEORIGIN (block clickjacking)"
msgstr "X-Frame-Options：SAMEORIGIN（クリックジャッキングをブロック）"

msgid "XML-RPC is disabled"
msgstr "XML-RPC は無効になっています"

msgid "Yes"
msgstr "はい"

msgid "Yes — preview as a visitor"
msgstr "はい — 訪問者としてプレビュー"

msgid "You are not allowed to create this post type."
msgstr "この投稿タイプを作成する権限がありません。"

msgid "You are not allowed to duplicate this item."
msgstr "この項目を複製する権限がありません。"

msgid "You are not logged in"
msgstr "ログインしていません"

msgid "You can adjust the compression level of the image from 5 to 100 (100 being no compression)"
msgstr "画像の圧縮レベルを 5 から 100 まで調整できます（100 は無圧縮）"

msgid "You can create your widget by activating it and entering content into the box below"
msgstr "有効にして下のボックスにコンテンツを入力することで、ウィジェットを作成できます"

msgid "You can customize the role of successful registrants, with the default role being \"subscriber\""
msgstr "登録に成功したユーザーの権限をカスタマイズできます。デフォルトの権限は「購読者」です"

msgid "You can disable default widgets on the dashboard that you dont use"
msgstr "ダッシュボードで使用していないデフォルトのウィジェットを無効にできます"

msgid "You can further customize your login page by enabling this feature"
msgstr "この機能を有効にすることで、ログインページをさらにカスタマイズできます"

msgid "You can hide Horse Tools from the WP menu, but you can still access it through the link. This will hide Horse Tools for all accounts"
msgstr "Horse Tools を WP メニューから非表示にできますが、リンクを通じて引き続きアクセスできます。これはすべてのアカウントで Horse Tools を非表示にします"

msgid "You can paste the shortcode into the position where you want the login button to appear"
msgstr "ログインボタンを表示したい位置にショートコードを貼り付けることができます"

msgid "You can preview your file here:"
msgstr "ここでファイルをプレビューできます："

msgid "You can use the shortcode in the editor and add it to the position you want, note: only use 1 shortcode in the post"
msgstr "エディターでショートコードを使用し、任意の位置に追加できます。注意：1 つの投稿につきショートコードは 1 つのみ使用してください"

msgid "You can use the shortcode to add the search icon to the location you want"
msgstr "ショートコードを使用して、任意の場所に検索アイコンを追加できます"

msgid "You do not have permission to do this."
msgstr "この操作を行う権限がありません。"

msgid "You do not have permission to upload SVG files."
msgstr "SVG ファイルをアップロードする権限がありません。"

msgid "You have successfully copied"
msgstr "正常にコピーしました"

msgid "You have unsaved changes."
msgstr "保存されていない変更があります。"

msgid "You havent added content yet"
msgstr "まだコンテンツを追加していません"

msgid "You need to activate this feature and customize the content below so that new registered users can receive emails"
msgstr "新規登録ユーザーがメールを受信できるように、この機能を有効にして以下のコンテンツをカスタマイズする必要があります"

msgid "Your Google account email address is not verified."
msgstr "あなたの Google アカウントのメールアドレスは検証されていません。"

msgid "Your comment has just been replied to"
msgstr "あなたのコメントに返信がありました"

msgid "Your comment has just been replied to in the post"
msgstr "投稿内であなたのコメントに返信がありました"

msgid "Your configuration has been saved"
msgstr "設定が保存されました"

msgid "Your custom widget"
msgstr "あなたのカスタムウィジェット"

msgid "Your database"
msgstr "あなたのデータベース"

msgid "[%s] New comment on the article \"%s\""
msgstr "[%s] 記事「%s」への新しいコメント"

msgid "days"
msgstr "日"

msgid "desktop"
msgstr "デスクトップ"

msgid "e.g. contact, promo"
msgstr "例：contact、promo"

msgid "e.g. sc, ht-snippet, vip"
msgstr "例：sc、ht-snippet、vip"

msgid "font-family:"
msgstr "font-family："

msgid "hrs"
msgstr "時間"

msgid "icons"
msgstr "アイコン"

msgid "images"
msgstr "画像"

msgid "jQuery Migrate is a library used to maintain the operation of certain themes, plugins that rely on older code. If your website no longer relies on this library, you can disable it"
msgstr "jQuery Migrate は、古いコードに依存する一部のテーマやプラグインの動作を維持するために使用されるライブラリです。ウェブサイトがこのライブラリに依存しなくなった場合は、無効にできます"

msgid "logged-in"
msgstr "ログイン済み"

msgid "logged-out"
msgstr "ログアウト済み"

msgid "min"
msgstr "分"

msgid "mobile"
msgstr "モバイル"

msgid "nofollow + new tab on external links"
msgstr "外部リンクに nofollow + 新しいタブ"

msgid "off"
msgstr "オフ"

msgid "post type, e.g. shortcoder"
msgstr "投稿タイプ、例：shortcoder"

msgid "sec"
msgstr "秒"

msgid "showing first"
msgstr "先頭を表示中"

msgid "third-party host(s) found"
msgstr "サードパーティのホストが見つかりました"

msgid "up to %s"
msgstr "最大 %s"

msgid "v3 score threshold (0 – 1)"
msgstr "v3 スコアのしきい値（0 – 1）"

msgid "— Insert a shortcode —"
msgstr "— ショートコードを挿入 —"
