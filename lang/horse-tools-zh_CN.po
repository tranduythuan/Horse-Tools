msgstr "请先输入当前的双重验证代码以解锁 PHP 编辑功能。"

msgid "Enter the 6-digit code from your app, or a backup code."
msgstr "请输入您应用中的 6 位数代码，或使用一个备用代码。"

msgid "Enter your authentication code."
msgstr "请输入您的验证代码。"

msgid "Entrance effect"
msgstr "进入特效"

