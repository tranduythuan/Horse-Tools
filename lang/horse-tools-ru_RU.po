msgstr "Столбец с номером строки"

msgid "Rows"
msgstr "Строки"

msgid "Rows/page"
msgstr "Строк/страница"

msgid "Run this snippet as PHP"
msgstr "Выполнить этот сниппет как PHP"

msgid "SAVE FONT SETTINGS"
msgstr "СОХРАНИТЬ НАСТРОЙКИ ШРИФТА"

msgid "SEO"
msgstr "SEO"

msgid "SMTP key"
msgstr "SMTP-ключ"

msgid "SMTP password"
msgstr "Пароль SMTP"

