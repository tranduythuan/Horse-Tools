msgid "“All” mode — scripts to NEVER delay (one per line). A hero slider or a cookie-consent script usually belongs here."
msgstr "Mode “Semua” — skrip yang TIDAK PERNAH ditunda (satu per baris). Slider hero atau skrip persetujuan cookie biasanya termasuk di sini."

msgid "“Listed” mode — scripts to delay (one per line: a handle, file name or part of a URL). Leave empty to use the built-in list of common trackers."
msgstr "Mode “Terdaftar” — skrip yang ditunda (satu per baris: handle, nama file, atau bagian URL). Kosongkan untuk menggunakan daftar bawaan pelacak umum."

msgid "← enter code and press \"Update profile\" to enable"
msgstr "← masukkan kode dan tekan “Perbarui profil” untuk mengaktifkan"

msgid "✓ Turned on — press SAVE to apply"
msgstr "✓ Aktif — tekan SIMPAN untuk menerapkan"
